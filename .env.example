DATABASE_URL=postgresql://user:password@localhost:5432/dominion_db

# Admin JWT Secret Key (Generate a random 32+ char hex/base64 string)
JWT_SECRET=super-secret-random-32-character-key-here-for-jwt-signing

# Cloudinary Storage Credentials for Multipart File Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Super Admin Seed Credentials
ADMIN_INIT_NAME=Dominion Super Admin
ADMIN_INIT_EMAIL=admin@dominionltd.ng
ADMIN_INIT_PASSWORD=ChangeThisSecurePassword2026!

# App URL (For CORS & Absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
